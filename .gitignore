# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-prod/
/out/

# production
/build

# electron
/dist
/dist-electron
/scheduler.cjs
/build-resources

# misc
.DS_Store
*.pem

# local environment / secrets
.env
.env.*
!.env.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# data (runtime data, not code)
/data

# debug / temp
debug.log
nul

# typescript
*.tsbuildinfo
next-env.d.ts
